APP_NAME="FamilyFund Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.familyfunds.app

ALLOW_REGISTRATION=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=contribution_tracker_staging
DB_USERNAME=app_user_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=staging.familyfunds.app
SESSION_COOKIE=familyfund_staging_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LARAVEL_PDF_DRIVER=dompdf
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=familyfund_staging_cache

MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@familyfunds.app"
MAIL_FROM_NAME="${APP_NAME}"

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
VITE_PAYSTACK_PUBLIC_KEY="${PAYSTACK_PUBLIC_KEY}"

VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AI_AGENT_PROVIDER=ollama
AI_AGENT_MODEL=llama3.2
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OPENAI_API_KEY=
MISTRAL_API_KEY=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13715
VITE_INERTIA_SSR_PORT=13715
VITE_INERTIA_SSR_CLUSTER=false
VITE_APP_NAME="${APP_NAME}"

BACKUP_RCLONE_ENABLED=false
